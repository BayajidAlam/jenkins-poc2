# =====================================================================================
# .env.example — copy to .env and fill in JENKINS_AGENT_SECRET before `docker compose up`
#
# The secret here is the JNLP secret Jenkins issues for both permanent nodes
# (agent-build and agent-push). Both compose services use the same secret because
# both nodes share a single JNLP enrollment contract.
#
# Generate one with:    openssl rand -hex 32
# Then paste it into Jenkins UI: Manage Jenkins → Nodes → <node> → Reveal secret
# =====================================================================================

JENKINS_AGENT_SECRET=replace_me_with_openssl_rand_hex_32
